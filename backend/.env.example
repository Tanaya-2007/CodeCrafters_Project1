# Copy to .env and adjust. Never commit .env
PORT=3000
# PostgreSQL (teammate-owned, see ../database/schema.sql). If unset/unreachable,
# backend uses ephemeral in-memory storage — data is still 100% live-fetched.
DATABASE_URL=postgres://user:password@localhost:5432/sarkaritrack
# Admin console credentials (change in production)
ADMIN_EMAIL=admin@sarkari.track
ADMIN_PASSWORD=admin123
# Scheduler: cron expression for official-source checks (default every 6h)
SCRAPE_CRON=0 */6 * * *
